{
  "name": "scene-39-personal-workstation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:peer": "node scripts/dev-peer.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 4173",
    "runtime": "node runtime/server.mjs",
    "runtime:check": "node runtime/check.mjs",
    "runtime:smoke": "node runtime/smoke.mjs",
    "lint": "eslint src/components/surface tests/visual playwright.config.ts",
    "check:surface": "node --experimental-strip-types scripts/surface-humanize.check.ts",
    "visual": "playwright test -c playwright.config.ts",
    "visual:update": "playwright test -c playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html-to-docx": "^1.8.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "browserslist": "^4.24.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.11"
  },
  "overrides": {
    "browserslist": "^4.24.0"
  }
}
