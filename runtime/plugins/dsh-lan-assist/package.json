    "tools.js",
    "commands.js",
    "client.js",
    "vendor/office",
    "cordis.patch.yml",
    "README.md",
    "scripts/install.sh",
    "scripts/install.cmd",
    "scripts/pack.sh"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "pack": "sh scripts/pack.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/losebird/dsh-lan-assist.git"
  },
  "homepage": "https://github.com/losebird/dsh-lan-assist",
  "bugs": {
    "url": "https://github.com/losebird/dsh-lan-assist/issues"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "lan",
    "secretary"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-cordis-client-runner"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {
    "nats": "2.29.3"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
