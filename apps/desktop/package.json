{
  "name": "@fde-x/desktop",
  "private": true,
  "version": "0.1.0-poc",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json",
    "pack:mac": "node ../../scripts/pack/mac-pack.mjs",
    "start": "pnpm run build && electron .",
    "start:dev": "FDE_DESKTOP_DEV=1 pnpm run start",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "44.7.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  }
}
